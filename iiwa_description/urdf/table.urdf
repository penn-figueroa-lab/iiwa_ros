<?xml version="1.0"?>
<robot name="table">
  <link name="world"/> <!-- Dummy world link for validation -->

  <link name="table_link">
    <visual>
      <geometry>
        <box size="1.0 2.0 0.1"/> <!-- Table dimensions -->
      </geometry>
      <material name="brown">
        <color rgba="0.7 0.4 0.2 1.0"/> <!-- Brownish color -->
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="1.0 2.0 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <joint name="fixed_to_world" type="fixed">
    <parent link="world"/>
    <child link="table_link"/>
    <origin xyz="0.7 0 0.2"/> <!-- Table position -->
  </joint>
</robot>

